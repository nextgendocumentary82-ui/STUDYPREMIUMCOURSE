# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/study-premium-course?retryWrites=true&w=majority

# Long random JWT secret (32+ characters recommended)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_32_PLUS_CHARS

# Razorpay keys - keep these ONLY on the server
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx

# Public URL after Render deployment, e.g. https://study-premium-course.onrender.com
PUBLIC_URL=https://YOUR-RENDER-SERVICE.onrender.com

# First admin account used by scripts/seed.js
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
ADMIN_SECRET_KEY=CHANGE_THIS_LONG_ADMIN_SECRET

PORT=10000
NODE_ENV=production

# Backblaze B2 Storage
# Create a private bucket and a restricted application key with read/write access.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_BUCKET_ID=

# Donation testing
DONATION_DEV_OTP=true  # local testing only; use false in production with SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Razorpay Dashboard webhook secret (server only)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
